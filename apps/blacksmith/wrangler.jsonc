// The MHFU Blacksmith site on Cloudflare: a Worker with only static assets
// (no script), so every request is a free static asset request. Deployed by
// the "Deploy to Cloudflare" workflow (.github/workflows/cloudflare-deploy.yml)
// after `pnpm build` has written out/.
{
  "name": "mhfu-blacksmith",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./out",
    // `next build` exports trailingSlash pages as <page>/index.html, which
    // this serves at /<page>/ (and redirects /<page> to it), as Next expects.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Production at mhfu-blacksmith.<account>.workers.dev, and a preview URL
  // per branch (see the workflow).
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for branches
  // other than main. Empty: assets and compatibility settings stay above.
  "previews": {},
}
