{
  "name": "blacksmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-data.ts && tsx scripts/generate-search-index.ts && tsx scripts/generate-embeds.ts && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p .",
    "generate-data": "tsx scripts/generate-data.ts",
    "generate-search": "tsx scripts/generate-search-index.ts",
    "validate": "tsx scripts/validate.ts",
    "bench-set-search": "tsx scripts/bench-set-search.ts",
    "test": "tsx --test test/**/*.test.ts",
    "validate-schema": "tsx scripts/validate-schema.ts",
    "generate-maps": "tsx scripts/generate-maps.ts",
    "generate-embeds": "tsx scripts/generate-embeds.ts",
    "generate-equipment-ids": "tsx scripts/generate-equipment-ids.ts",
    "release-json": "mkdir -p mhfu_weapon_information && cp ../../data/weapons/*.json mhfu_weapon_information/ && zip -m -9 -r mhfu_weapon_information.zip mhfu_weapon_information"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "modern-normalize": "^3.0.1",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.169.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.169.0",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.25",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
