# Response headers for every page of dist/: build.mjs copies this file there,
# and Cloudflare reads it. The page's own Content-Security-Policy is a <meta>
# tag in head.html, so it holds wherever dist/ is hosted. These are the parts
# a <meta> tag can't set.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
