// Whetstone's web app on Cloudflare: a Worker serving the static assets in
// dist/, with no script, so every request is a free static one. Deployed by
// the "Deploy to Cloudflare" workflow (.github/workflows/cloudflare-deploy.yml)
// after `pnpm build` has written dist/. Response headers are in _headers,
// which build.mjs copies into dist/.
{
  "name": "whetstone",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
  },
  // Production at whetstone.<account>.workers.dev until a custom domain is
  // added to the Worker, and a preview URL per branch (see the workflow).
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for branches
  // other than main. Empty: assets and compatibility settings stay above.
  "previews": {},
}
