    "test:e2e": "tsx e2e.mts"
  },
  "dependencies": {
    "mhfu-extract": "workspace:*",
    "randomfu": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "buffer": "6.0.3",
    "esbuild": "0.25.10",
    "postcss": "^8.5.25",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
