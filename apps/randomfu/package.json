{
  "name": "randomfu-web",
  "version": "0.1.0",
  "private": true,
  "description": "randomfu as a static web app: the randomizer runs in the browser on the user's own disc image.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
