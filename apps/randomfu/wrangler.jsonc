// randomfu's web app on Cloudflare: a Worker serving the static assets in
// dist/, with a script only for analytics events. Deployed by the "Deploy
// to Cloudflare" workflow (.github/workflows/cloudflare-deploy.yml) after
// `pnpm build` has written dist/. Response headers are in _headers, which
// build.mjs copies into dist/.
{
  "name": "randomfu",
  "compatibility_date": "2026-10-22",
  // Only runs for analytics events (run_worker_first below), which it writes
  // to the EVENTS dataset. See the file.
  "main": "analytics/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // These count as Worker requests (EVENT_PATH in analytics/events.ts).
    // Every other request for an asset that exists is a free static one that
    // never runs the script; a request for one that doesn't (a broken link,
    // a scanner) falls through to the script, which hands it to ASSETS for
    // its 404, and counts as a Worker request too.
    "run_worker_first": ["/e"],
  },
  // Workers Analytics Engine, made on the first write. `pnpm analytics`
  // reads it (analytics/report.mts).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "randomfu_events" }],
  // Events per minute from one address, per Cloudflare location (approximate):
  // a coarse flood guard. A visit sends a few dozen at most, and many
  // visitors can share one address. The namespace_id must be unique on the
  // account, or another Worker's limiter would share these counters.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "417001", "simple": { "limit": 1500, "period": 60 } },
  ],
  // Production at randomfu.<account>.workers.dev until randomfu.vallode.com
  // is added as a custom domain, and a preview URL per branch (see the
  // workflow).
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for branches
  // other than main. Empty: assets and compatibility settings stay above.
  "previews": {},
}
