.DS_Store

# Pages generated by the old Zola build; may still exist in older checkouts
apps/blacksmith/content/**/*.md

# Next.js build-time generated files under public/ (source assets like
# public/images, public/fonts, public/manifest.json, public/javascript are
# tracked and must NOT be ignored — this used to be a blanket "public" rule
# left over from the old Zola build, which silently dropped those source
# assets from the repo).
/apps/blacksmith/public/data
/apps/blacksmith/public/search-data.json
/apps/blacksmith/public/embed
/apps/blacksmith/public/sw.js
/apps/blacksmith/public/workbox-*.js
/apps/blacksmith/public/swe-worker-*.js
/apps/blacksmith/public/fallback-*.js

# vim temporary files
**/.*.sw*
.swp

node_modules
.pnpm-store

# Cursor IDE local metadata
.cursor

# Next.js
.next
out

# Vercel
.vercel

# TypeScript incremental build info
tsconfig.tsbuildinfo

# Python tools / local research directories
mhef/

# Game disc images and unpacked/extracted dumps — never commit copyrighted
# game data. See packages/mhfu-extract/README.md.
*.iso
*.cso
*.pbp
packages/mhfu-extract/.cache/
packages/mhfu-extract/**/*.iso
packages/mhfu-extract/**/*.cso
# randomfu web app build output
apps/randomfu/dist/
