  "description": "Seeded randomizer for Monster Hunter Freedom Unite / Portable 2nd G. Patches the user's own disc image and writes a spoiler log.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "randomize": "tsx src/cli.ts randomize",
    "roundtrip": "tsx src/cli.ts roundtrip",
    "eboot-info": "tsx src/cli.ts eboot-info",
    "gui": "tsx src/cli.ts gui",
    "settings": "tsx src/cli.ts settings",
    "test": "tsx --test test/**/*.test.ts",
    "shop-scan": "tsx src/cli.ts shop-scan",
    "shop-lists": "tsx src/cli.ts shop-lists",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "mhfu-extract": "workspace:*",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^22",
