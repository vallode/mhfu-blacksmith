{
  "name": "mhfu-extract",
  "version": "0.1.0",
  "private": true,
  "description": "Datamining pipeline that extracts weapon/armor/item/decoration/monster/quest data directly from an MHFU (MHP2G) PSP ISO and emits the mhfu-blacksmith data/ JSON schema.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "unpack": "tsx src/cli.ts unpack",
    "extract": "tsx src/cli.ts extract",
    "diff": "tsx src/cli.ts diff",
    "models": "tsx src/cli.ts models",
    "export-site": "tsx src/cli.ts export-site",
    "compare": "tsx src/cli.ts compare",
    "build-data": "tsx src/cli.ts build-data",
    "quest-flags": "tsx src/cli.ts quest-flags",
    "quest-probe": "tsx src/cli.ts quest-probe",
    "quest-text-scan": "tsx src/cli.ts quest-text-scan",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "meshoptimizer": "0.21.0",
    "sharp": "0.34.5",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
