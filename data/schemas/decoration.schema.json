{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decorations file",
  "type": "object",
  "required": ["decorations"],
  "additionalProperties": false,
  "properties": {
    "decorations": {
      "type": "array",
      "items": { "$ref": "#/definitions/decoration" }
    }
  },
  "definitions": {
    "material": {
      "type": "object",
      "required": ["item", "amount", "type", "color"],
      "additionalProperties": false,
      "properties": {
        "item":   { "type": "integer", "minimum": 1, "description": "Item ID (data/items.json); its name is in data/strings" },
        "amount": { "type": "integer", "minimum": 1 },
        "type":   { "type": "string", "minLength": 1 },
        "color":  { "type": "string", "minLength": 1 }
      }
    },
    "decoration": {
      "type": "object",
      "required": ["id", "type", "rarity", "slots", "skills"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "integer", "minimum": 1, "description": "The decoration's item ID (data/items.json). Its name is the item's, or data/strings' 'decoration' entry where the site names it otherwise" },
        "type":     { "type": "string" },
        "rarity":   { "type": "integer", "minimum": 1, "maximum": 10 },
        "slots":    { "type": "integer", "minimum": 0, "maximum": 3 },
        "color":    { "type": "string" },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "points"],
            "additionalProperties": false,
            "properties": {
              "skill":  { "type": "integer", "minimum": 1, "description": "Skill tree ID (SkillID; data/skills.json)" },
              "alias":  { "type": "integer", "minimum": 0, "description": "Spelled as the tree's n-th English alias (data/strings/en.json aliases.skill), as the site showed it" },
              "points": { "type": "integer", "not": { "const": 0 } }
            }
          },
          "minItems": 1
        },
        "create_cost": { "type": "integer", "minimum": 0 },
        "create_mats": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/definitions/material" } },
            { "type": "null" }
          ]
        },
        "alternative_create_mats": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/definitions/material" } },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
