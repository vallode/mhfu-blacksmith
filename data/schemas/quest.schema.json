{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quests file",
  "type": "object",
  "required": ["quests"],
  "additionalProperties": false,
  "properties": {
    "quests": {
      "type": "array",
      "items": { "$ref": "#/definitions/quest" }
    }
  },
  "definitions": {
    "supply": {
      "type": "object",
      "required": ["item", "amount"],
      "additionalProperties": false,
      "properties": {
        "item":   { "type": "string", "minLength": 1 },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    "reward_item": {
      "type": "object",
      "required": ["chance", "item", "amount"],
      "additionalProperties": false,
      "properties": {
        "chance": { "type": "integer", "minimum": 0, "maximum": 100 },
        "item":   { "type": "string", "minLength": 1 },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    "reward_table": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "$comment": "kind/draws/condition decode RewardTBL.Unkn1/Unkn2; see mhfu-extract's README, 'Reward tables'.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["main", "extra", "conditional"],
          "$comment": "main: the main reward pool (Unkn1 0x8000). extra: a fixed extra reward, one draw (0x8001). conditional: awarded on a condition kept raw in 'condition'."
        },
        "draws": {
          "type": ["integer", "null"],
          "minimum": 0,
          "$comment": "Times the table is drawn. For main tables this is the base count before Luck skills, inferred from Unkn2's high byte. Null where unknown (conditional tables)."
        },
        "condition": {
          "type": ["integer", "null"],
          "minimum": 0,
          "$comment": "Raw RewardTBL.Unkn1 of a conditional table, undecoded. Null for main and extra tables."
        },
        "items": { "type": "array", "items": { "$ref": "#/definitions/reward_item" } }
      }
    },
    "monster_size": {
      "type": "object",
      "required": ["modifier", "min", "max"],
      "additionalProperties": false,
      "$comment": "The size, in percent, the quest's large monsters roll; see mhfu-extract's src/monsters/sizes.ts. 'modifier' is the header's MonSizeModifier, the centre of the roll; 'min' and 'max' bound it after the header's size variation (u8 at 0x4a). Monsters without crowns are always 100. 'fixed_until_flag': the monsters stay at 'modifier' until this save flag is set (likely the quest's first clear).",
      "properties": {
        "modifier":         { "type": "integer", "minimum": 0 },
        "min":              { "type": "integer", "minimum": 0 },
        "max":              { "type": "integer", "minimum": 0 },
        "fixed_until_flag": { "type": "integer", "minimum": 0 }
      }
    },
    "monster_spawn": {
      "type": "object",
      "required": ["monster", "quantity", "power"],
      "additionalProperties": false,
      "properties": {
        "monster":  { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 0 },
        "power":    { "type": "integer", "minimum": 0 },
        "multipliers": {
          "type": "object",
          "required": ["hp", "attack", "defense", "status"],
          "additionalProperties": false,
          "$comment": "The quest's stat multipliers for this monster, picked by the monster's multiplier set, the quest's stat table and 'power'; see mhfu-extract's src/monsters/multipliers.ts. HP is the monster's base_hp times 'hp', rounded down. 'defense' scales damage taken (lower: tougher). 'status' scales the parts' flinch thresholds. Furious Rajang's attack and defense are scaled again at run time.",
          "properties": {
            "hp":      { "type": "number", "exclusiveMinimum": 0 },
            "attack":  { "type": "number", "exclusiveMinimum": 0 },
            "defense": { "type": "number", "exclusiveMinimum": 0 },
            "status":  { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "small_monster_spawn": {
      "type": "object",
      "required": ["monster", "max_quantity", "total_quantity"],
      "additionalProperties": false,
      "properties": {
        "monster":        { "type": "string", "minLength": 1 },
        "max_quantity":   { "type": "integer", "minimum": 0, "$comment": "The most of this species in any single zone." },
        "total_quantity": { "type": "integer", "minimum": 0, "$comment": "All of this species across the quest's zones; zone tables that share an address are counted once." },
        "endless":        { "const": true, "$comment": "A spawn of this species is marked 99, the game's value for one that keeps coming; those spawns are not in the counts." }
      }
    },
    "target": {
      "type": "object",
      "required": ["monster", "amount"],
      "additionalProperties": false,
      "properties": {
        "monster": { "type": "string", "minLength": 1 },
        "amount":  { "type": "integer", "minimum": 1 }
      }
    },
    "quest": {
      "type": "object",
      "required": ["id", "hub", "stars", "fee", "reward", "penalty", "time_limit_minutes"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "integer" },
        "hub": {
          "type": "string",
          "enum": ["village", "guild", "training-school", "treasure-hunting"]
        },
        "rank": {
          "type": ["string", "null"],
          "enum": ["low-rank", "high-rank", "g-rank", null]
        },
        "stars":               { "type": "integer", "minimum": 1 },
        "map":                 { "type": ["string", "null"] },
        "fee":                 { "type": "integer", "minimum": 0 },
        "reward":              { "type": "integer", "minimum": 0 },
        "penalty":             { "type": "integer", "minimum": 0 },
        "time_limit_minutes":  { "type": "integer", "minimum": 0 },
        "target": {
          "oneOf": [{ "$ref": "#/definitions/target" }, { "type": "null" }]
        },
        "supplies":       { "type": "array", "items": { "$ref": "#/definitions/supply" } },
        "reward_tables":  { "type": "array", "items": { "$ref": "#/definitions/reward_table" } },
        "large_monsters": { "type": "array", "items": { "$ref": "#/definitions/monster_spawn" } },
        "small_monsters": { "type": "array", "items": { "$ref": "#/definitions/small_monster_spawn" } },
        "monster_size": {
          "oneOf": [{ "$ref": "#/definitions/monster_size" }, { "type": "null" }],
          "$comment": "null when the quest has no large monsters."
        },
        "title":   { "type": ["string", "null"], "$comment": "Extracted verbatim from the disc: English on the EU disc. See mhfu-extract's README." },
        "goal":    { "type": ["string", "null"], "$comment": "See 'title'." },
        "details": { "type": ["string", "null"], "$comment": "See 'title'." },
        "fail":    { "type": ["string", "null"], "$comment": "See 'title'." },
        "client":  { "type": ["string", "null"], "$comment": "See 'title'." },
        "requires": {
          "type": ["integer", "null"],
          "$comment": "ID of the quest that must be cleared before this one appears. Not on the disc: hand-entered in mhfu-extract's src/tables/quest-prerequisites.ts. Null when there is none or none is known."
        },
        "urgent": {
          "type": "boolean",
          "$comment": "An Urgent Quest, which unlocks the next star level. Not decoded from the disc: hand-entered in mhfu-extract's src/tables/urgent-quests.ts."
        }
      }
    }
  }
}
