{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Armor file",
  "type": "object",
  "required": ["armor"],
  "additionalProperties": false,
  "properties": {
    "armor": {
      "type": "array",
      "items": { "$ref": "#/definitions/armor_piece" }
    }
  },
  "definitions": {
    "material": {
      "type": "object",
      "required": ["item", "amount", "type", "color"],
      "additionalProperties": false,
      "properties": {
        "item":   { "type": "integer", "minimum": 1, "description": "Item ID (data/items.json); its name is in data/strings" },
        "amount": { "type": "integer", "minimum": 1 },
        "type":   { "type": "string", "minLength": 1 },
        "color":  { "type": "string", "minLength": 1 }
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill", "amount"],
      "additionalProperties": false,
      "properties": {
        "skill":  { "type": "integer", "minimum": 1, "description": "Skill tree ID (SkillID; data/skills.json)" },
        "alias":  { "type": "integer", "minimum": 0, "description": "Spelled as the tree's n-th English alias (data/strings/en.json aliases.skill), as the site showed it" },
        "amount": { "type": "integer" }
      }
    },
    "armor_piece": {
      "type": "object",
      "required": ["id", "type", "rank", "rarity", "defence", "slots"],
      "additionalProperties": false,
      "properties": {
        "id":           { "type": "integer", "minimum": 0, "description": "The slot's game armor ID (as in a save's equipment box); the name is in data/strings, under the slot" },
        "type": {
          "type": "string",
          "enum": ["helmet", "plate", "gauntlets", "waist", "leggings"]
        },
        "rank": {
          "type": "string",
          "enum": ["low-rank", "high-rank", "g-rank"]
        },
        "rarity":       { "type": "integer", "minimum": 1, "maximum": 10 },
        "slots":        { "type": "integer", "minimum": 0, "maximum": 3 },
        "defence":      { "type": "integer", "minimum": 0 },
        "max_defence":  { "type": "integer", "minimum": 0 },
        "max_defence_pre_ukanlos": { "type": "integer", "minimum": 0 },
        "fire_res":     { "type": "integer" },
        "thunder_res":  { "type": "integer" },
        "dragon_res":   { "type": "integer" },
        "water_res":    { "type": "integer" },
        "ice_res":      { "type": "integer" },
        "sex":          { "type": "string", "enum": ["Male/Female", "Male", "Female"] },
        "hunter_type":  { "type": "string", "enum": ["Blademaster/Gunner", "Blademaster", "Gunner"] },
        "hr":           { "type": ["string", "integer"] },
        "elder":        { "type": ["string", "integer"] },
        "create_cost":  { "type": ["integer", "null"], "minimum": 0 },
        "skills": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/definitions/skill" } },
            { "type": "null" }
          ]
        },
        "create_mats": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/definitions/material" } },
            { "type": "null" }
          ]
        },
        "alternative_create_mats": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/definitions/material" } },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
