{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills file",
  "description": "Skill trees and the skills they activate at each points threshold. Names are in data/strings: a tree's in 'skill' (the game's SkillID spelling) and 'aliases.skill' (other spellings, which armor and decorations refer to by index), a skill's in 'skill_activation' under '<tree ID>:<points>'.",
  "type": "object",
  "required": ["skills"],
  "additionalProperties": false,
  "properties": {
    "skills": {
      "type": "array",
      "items": { "$ref": "#/definitions/tree" }
    }
  },
  "definitions": {
    "tree": {
      "type": "object",
      "required": ["id", "skills"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "description": "The game's skill tree ID (SkillID)" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["points"],
            "additionalProperties": false,
            "properties": {
              "points": { "type": "integer", "not": { "const": 0 } }
            }
          }
        }
      }
    }
  }
}
