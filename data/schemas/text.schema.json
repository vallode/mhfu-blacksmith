{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Disc text file",
  "description": "The game's own names and descriptions in one language, from the EU disc's str_tbl (mhfu-extract disc-text). Arrays are indexed by game ID; null where the ID is 0 or unused on the EU disc.",
  "type": "object",
  "required": [
    "language",
    "items",
    "melee",
    "ranged",
    "helmet",
    "plate",
    "gauntlets",
    "waist",
    "leggings",
    "skill_trees",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "language": { "enum": ["en", "fr", "de", "it", "es"] },
    "items": {
      "description": "By item ID (data/items.json)",
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    },
    "melee": { "$ref": "#/definitions/equipment", "minItems": 1150, "maxItems": 1150 },
    "ranged": { "$ref": "#/definitions/equipment", "minItems": 354, "maxItems": 354 },
    "helmet": { "$ref": "#/definitions/equipment", "minItems": 436, "maxItems": 436 },
    "plate": { "$ref": "#/definitions/equipment", "minItems": 420, "maxItems": 420 },
    "gauntlets": { "$ref": "#/definitions/equipment", "minItems": 411, "maxItems": 411 },
    "waist": { "$ref": "#/definitions/equipment", "minItems": 409, "maxItems": 409 },
    "leggings": { "$ref": "#/definitions/equipment", "minItems": 420, "maxItems": 420 },
    "skill_trees": {
      "description": "By skill tree ID (the game's SkillID)",
      "$ref": "#/definitions/names",
      "minItems": 100,
      "maxItems": 100
    },
    "skills": {
      "description": "By skill ID (the \"Skills 2\" list in mhp2g-patterns' equip.enum)",
      "$ref": "#/definitions/names",
      "minItems": 218,
      "maxItems": 218
    }
  },
  "definitions": {
    "entry": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["name", "description"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": {
              "type": "string",
              "description": "With the game's own line breaks (\\n); color codes removed"
            }
          }
        }
      ]
    },
    "equipment": {
      "description": "By equipment ID, as in data/equipment-ids.json",
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    },
    "names": {
      "type": "array",
      "items": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
    }
  }
}
