{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monsters file",
  "type": "object",
  "required": ["monsters"],
  "additionalProperties": false,
  "properties": {
    "monsters": {
      "type": "array",
      "items": { "$ref": "#/definitions/monster" }
    }
  },
  "definitions": {
    "monster": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name":        { "type": "string", "minLength": 1 },
        "type":        { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon":        { "type": "string" },
        "habitats":    { "type": "array" },
        "sizes":       { "type": "object" },
        "base_hp":     { "type": "integer", "minimum": 0 },
        "drops":       { "type": "object" },
        "hitzones":    { "type": "object" },
        "breaks":      { "type": "array", "items": { "$ref": "#/definitions/break" } },
        "flinch_thresholds": {
          "type": "array",
          "maxItems": 9,
          "items": { "type": ["integer", "null"], "minimum": 1 }
        },
        "tolerances":  { "$ref": "#/definitions/tolerances" }
      }
    },
    "tolerances": {
      "description": "Status tolerances from the disc; null where the monster is immune. Times are in game ticks.",
      "type": "object",
      "required": ["paralysis", "sleep", "ko", "poison"],
      "additionalProperties": false,
      "properties": {
        "paralysis": { "$ref": "#/definitions/status_tolerance" },
        "sleep":     { "$ref": "#/definitions/status_tolerance" },
        "ko":        { "$ref": "#/definitions/status_tolerance" },
        "poison":    { "$ref": "#/definitions/poison_tolerance" }
      }
    },
    "status_tolerance": {
      "type": ["object", "null"],
      "required": ["initial", "increase", "recovery", "recovery_time", "duration"],
      "additionalProperties": false,
      "properties": {
        "initial":       { "type": "integer", "minimum": 0 },
        "increase":      { "type": "integer", "minimum": 0 },
        "recovery":      { "type": "integer", "minimum": 0 },
        "recovery_time": { "type": "integer", "minimum": 0 },
        "duration":      { "type": "integer", "minimum": 0 }
      }
    },
    "poison_tolerance": {
      "type": ["object", "null"],
      "required": ["initial", "increase", "recovery", "recovery_time", "damage", "damage_interval", "total_time"],
      "additionalProperties": false,
      "properties": {
        "initial":         { "type": "integer", "minimum": 0 },
        "increase":        { "type": "integer", "minimum": 0 },
        "recovery":        { "type": "integer", "minimum": 0 },
        "recovery_time":   { "type": "integer", "minimum": 0 },
        "damage":          { "type": "integer", "minimum": 0 },
        "damage_interval": { "type": "integer", "minimum": 0 },
        "total_time":      { "type": "integer", "minimum": 0 }
      }
    },
    "break": {
      "type": "object",
      "required": ["name", "parts", "flinches"],
      "additionalProperties": false,
      "properties": {
        "name":      { "type": "string", "minLength": 1 },
        "parts":     { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
        "flinches":  { "type": ["integer", "null"], "minimum": 1 },
        "all_parts": { "type": "boolean" },
        "below_hp":  { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "damage":    { "enum": ["cut", "fire", "dragon"] }
      }
    }
  }
}
