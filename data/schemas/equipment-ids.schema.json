{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Equipment IDs file",
  "description": "Game equipment IDs (as stored in a save file's equipment box) per equip type. Array index = ID; null = no item in data/. Generated by scripts/generate-equipment-ids.ts.",
  "type": "object",
  "required": ["leggings", "helmet", "plate", "gauntlets", "waist", "melee", "ranged"],
  "additionalProperties": false,
  "properties": {
    "leggings":  { "$ref": "#/definitions/armorIds" },
    "helmet":    { "$ref": "#/definitions/armorIds" },
    "plate":     { "$ref": "#/definitions/armorIds" },
    "gauntlets": { "$ref": "#/definitions/armorIds" },
    "waist":     { "$ref": "#/definitions/armorIds" },
    "melee": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "null" },
          { "$ref": "#/definitions/weapon" }
        ]
      }
    },
    "ranged": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "null" },
          { "$ref": "#/definitions/weapon" }
        ]
      }
    }
  },
  "definitions": {
    "armorIds": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sex":  { "enum": ["Male", "Female"] }
            }
          }
        ]
      }
    },
    "weapon": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
